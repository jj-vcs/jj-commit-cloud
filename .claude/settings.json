{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo tree:*)",

      "Bash(jj log:*)",
      "Bash(jj st:*)",
      "Bash(jj status:*)",
      "Bash(jj diff:*)",
      "Bash(jj show:*)",
      "Bash(jj file show:*)",
      "Bash(jj file annotate:*)",
      "Bash(jj evolog:*)",
      "Bash(jj op log:*)",
      "Bash(jj bookmark list:*)",
      "Bash(jj config get:*)",
      "Bash(jj config list:*)",

      "Bash(jj new:*)",
      "Bash(jj describe:*)",
      "Bash(jj commit:*)",
      "Bash(jj fix:*)",
      "Bash(jj git fetch:*)",

      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)"
    ],
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(jj git push --all:*)",
      "Bash(cargo publish:*)"
    ]
  }
}
